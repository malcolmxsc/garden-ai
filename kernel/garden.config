# =====================================================================
# Garden AI — Custom Kernel Config Overrides
# =====================================================================
# These are appended to the default arm64 defconfig. The `olddefconfig`
# pass resolves any dependency conflicts.
#
# Philosophy: CONFIG_MODULES=n means everything needed is built-in.
# No module loading, no modprobe, no /lib/modules/ in initramfs.
# =====================================================================

# --- VirtIO-vSock (THE WHOLE POINT) ---
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# --- Core VirtIO (Virtualization.framework devices) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_RNG=y
CONFIG_VIRTIO_BALLOON=y

# --- Networking (needed for DHCP / internet egress) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y

# --- Filesystem basics ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# --- Serial Console (PL011 for Virtualization.framework) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- Initramfs support ---
CONFIG_BLK_DEV_INITRD=y

# --- PCI (Virtualization.framework presents devices over PCI) ---
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# --- eBPF Security Telemetry ---
# Required for aya-based eBPF probe loading inside the guest VM.
# These enable syscall tracepoints (execve, openat, connect) and
# PerfEventArray for streaming events to userspace.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_TRACEPOINTS=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_PERF_EVENTS=y

# --- Kprobes (attach to arbitrary kernel functions) ---
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# --- Debug info & BTF ---
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y

# --- BPF-LSM (synchronous policy enforcement) ---
# Allows BPF programs to act as LSM hooks, enforcing policy synchronously
# before syscalls complete (returning -EPERM) rather than kill-on-detect.
# CONFIG_LSM must include "bpf" at the end or the hooks are never invoked.
CONFIG_BPF_LSM=y
CONFIG_LSM="lockdown,yama,integrity,apparmor,bpf"

# --- Disable modules (everything built-in) ---
CONFIG_MODULES=n

# --- Disable unnecessary subsystems for smaller kernel ---
# Aggressively strip drivers/subsystems to reduce vmlinux size,
# which is critical for BTF generation memory usage.
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WLAN=n
CONFIG_BLUETOOTH=n
CONFIG_DRM=n
CONFIG_INPUT_MOUSE=n
CONFIG_WIRELESS=n
CONFIG_HAMRADIO=n
CONFIG_CAN=n
CONFIG_NFC=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_STAGING=n
CONFIG_IIO=n
CONFIG_FPGA=n
CONFIG_GNSS=n
CONFIG_SOUNDWIRE=n
CONFIG_INTERCONNECT=n
CONFIG_REMOTEPROC=n
CONFIG_RPMSG=n
CONFIG_INFINIBAND=n
CONFIG_EDAC=n
CONFIG_CRYPTO_HW=n
CONFIG_TEE=n
CONFIG_HTE=n
CONFIG_COUNTER=n
CONFIG_NVMEM=n
CONFIG_MUX_GPIO=n
CONFIG_HWTRACING=n
CONFIG_DEVFREQ=n
# Strip heavyweight ethernet drivers (we only need VIRTIO_NET)
CONFIG_NET_VENDOR_MELLANOX=n
CONFIG_NET_VENDOR_INTEL=n
CONFIG_NET_VENDOR_BROADCOM=n
CONFIG_NET_VENDOR_REALTEK=n
CONFIG_NET_VENDOR_QUALCOMM=n
CONFIG_NET_VENDOR_STMICRO=n
CONFIG_NET_VENDOR_RENESAS=n
CONFIG_NET_VENDOR_TI=n
CONFIG_NET_VENDOR_MARVELL=n
CONFIG_NET_VENDOR_CADENCE=n
CONFIG_NET_VENDOR_HISILICON=n
CONFIG_NET_VENDOR_FREESCALE=n
CONFIG_NET_VENDOR_SMSC=n
CONFIG_NET_VENDOR_MICROCHIP=n
CONFIG_NET_VENDOR_MSCC=n
CONFIG_NET_VENDOR_SOCIONEXT=n
CONFIG_NET_VENDOR_AMD=n
CONFIG_NET_VENDOR_CORTINA=n
CONFIG_NET_VENDOR_GOOGLE=n
CONFIG_NET_VENDOR_HUAWEI=n
# More heavyweight subsystems
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_ACPI=n
